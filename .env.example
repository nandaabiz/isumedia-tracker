# URL PocketBase (jangan ekspos port ini ke publik; Nuxt server yang mengaksesnya)
POCKETBASE_URL=http://127.0.0.1:8290

# Akun servis PocketBase (role analyst/admin) untuk persistensi topik & media_posts dari server
PB_SERVICE_EMAIL=
PB_SERVICE_PASSWORD=

# Secret penandatangan token sesi (minimal 32 karakter). Buat dengan: openssl rand -hex 32
NUXT_SESSION_SECRET=

# Login akun demo saat PocketBase mati. Default: aktif di development, nonaktif di production
NUXT_DEMO_LOGIN=false

# Access token Threads API (izin threads_basic + threads_keyword_search). Kosong = konektor Threads dilewati.
# Tanpa persetujuan App Review untuk threads_keyword_search, pencarian hanya mencakup post milik akun token.
# Redirect Callback URL di app Meta: https://<domain>/oauth/threads (menampilkan kode otorisasi untuk ditukar menjadi token).
THREADS_ACCESS_TOKEN=

# Bearer token aplikasi X API v2 (paket dengan akses recent search). Kosong = konektor X dilewati.
X_BEARER_TOKEN=

# API key YouTube Data API v3 (Google Cloud Console). Kosong = memakai feed resmi kanal YOUTUBE_CHANNEL_IDS
# (tanpa pencarian kata kunci; hanya 15 video terbaru per kanal, tanpa jumlah komentar).
YOUTUBE_API_KEY=
# ID kanal (UC...) untuk feed tanpa API key, dipisah koma. Kosong = KOMPASTV, METRO TV, tvOneNews, Official iNews
YOUTUBE_CHANNEL_IDS=

# Client key & secret TikTok Research API (wajib disetujui program riset TikTok). Kosong = konektor TikTok dilewati.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Aplikasi Reddit tipe "script"/"web" untuk konektor forum publik. Kosong = memakai feed search.rss tanpa login
# (tanpa skor & jumlah komentar; dibatasi ±1 request/menit per IP, sering diblokir dari IP datacenter).
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Subreddit pantauan dipisah koma (default: indonesia)
REDDIT_SUBREDDITS=indonesia

# Alamat & port aplikasi Nuxt (production). 127.0.0.1 = hanya bisa diakses lewat reverse proxy Nginx
HOST=127.0.0.1
PORT=3020
