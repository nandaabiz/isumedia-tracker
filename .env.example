# URL PocketBase (jangan ekspos port ini ke publik; Nuxt server yang mengaksesnya)
POCKETBASE_URL=http://127.0.0.1:8290

# Akun servis PocketBase (role analyst/admin) untuk persistensi topik & media_posts dari server
PB_SERVICE_EMAIL=
PB_SERVICE_PASSWORD=

# Secret penandatangan token sesi (minimal 32 karakter). Buat dengan: openssl rand -hex 32
NUXT_SESSION_SECRET=

# Login akun demo saat PocketBase mati. Default: aktif di development, nonaktif di production
NUXT_DEMO_LOGIN=false

# Alamat & port aplikasi Nuxt (production). 127.0.0.1 = hanya bisa diakses lewat reverse proxy Nginx
HOST=127.0.0.1
PORT=3020
